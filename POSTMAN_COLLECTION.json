								},
								{
									"key": "job_type",
									"value": "full-time",
									"description": "Job type filter"
								},
								{
									"key": "location",
									"value": "Hồ Chí Minh",
									"description": "Location filter",
									"disabled": true
								},
								{
									"key": "company",
									"value": "VNG",
									"description": "Company filter",
									"disabled": true
								},
								{
									"key": "is_urgent",
									"value": "true",
									"description": "Urgent jobs only",
									"disabled": true
