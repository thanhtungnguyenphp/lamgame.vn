								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Unity Developer - Test Company\",\n  \"company_name\": \"Test Company\",\n  \"description\": \"<h2>Job Description</h2><p>We are looking for a skilled Unity Developer to join our team...</p>\",\n  \"short_description\": \"Unity Developer position at Test Company with competitive salary\",\n  \"job_type\": \"full-time\",\n  \"experience_level\": \"junior\",\n  \"salary_range\": \"20m-30m\",\n  \"job_location\": \"Hồ Chí Minh\",\n  \"company_size\": \"Nhỏ (10-50 người)\",\n  \"required_skills\": [\"Unity\", \"C#\", \"Git\"],\n  \"education_level\": \"Đại học\",\n  \"english_level\": \"Cơ bản\",\n  \"job_benefits\": [\"Bảo hiểm sức khỏe\", \"Đào tạo & phát triển\"],\n  \"application_deadline\": \"2025-12-31\",\n  \"contact_email\": \"hr@testcompany.com\",\n  \"contact_phone\": \"0123456789\",\n  \"company_website\": \"https://testcompany.com\",\n  \"application_method\": \"email\",\n  \"is_urgent\": false,\n  \"is_featured\": false,\n  \"categories\": [102],\n  \"meta_title\": \"Unity Developer - Test Company | LamGame Jobs\",\n  \"meta_description\": \"Unity Developer position at Test Company with competitive benefits\",\n  \"meta_keywords\": \"unity, developer, test company, game development\"\n}"
						},
						"url": {
							"raw": "{{base_url}}",
							"host": ["{{base_url}}"]
						}
