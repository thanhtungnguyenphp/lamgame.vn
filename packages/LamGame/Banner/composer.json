{
    "name": "lamgame/banner",
    "description": "Dynamic Banner Management Module for Bagisto with advanced caching and multi-device support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LamGame Team",
            "email": "dev@lamgame.vn"
        }
    ],
    "require": {
        "php": "^8.1",
        "bagisto/bagisto": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LamGame\\Banner\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LamGame\\Banner\\Providers\\BannerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}