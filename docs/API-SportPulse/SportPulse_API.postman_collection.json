{
	"info": {
		"name": "SportPulse API v1.0",
		"description": "SportPulse — Nhịp đập thể thao\nBase URL: https://lamgame.vn/api/v1/sport\nAuth: Firebase Bearer token (user endpoints only)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "baseUrl", "value": "https://lamgame.vn/api/v1/sport"},
		{"key": "firebaseToken", "value": "YOUR_FIREBASE_ID_TOKEN"}
	],
	"item": [
		{
			"name": "1. Sports & Leagues",
			"item": [
				{
					"name": "1.1 GET /sports",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/sports", "host": ["{{baseUrl}}"], "path": ["sports"]}
					}
				},
				{
					"name": "1.2 GET /leagues",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/leagues?sport=football",
							"host": ["{{baseUrl}}"],
							"path": ["leagues"],
							"query": [
								{"key": "sport", "value": "football", "description": "football|basketball|tennis|mma|esports"},
								{"key": "country", "value": "England", "disabled": true},
								{"key": "season", "value": "2025-2026", "disabled": true}
							]
						}
					}
				},
				{
					"name": "1.3 GET /leagues/{id}/standings",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/leagues/premier-league/standings", "host": ["{{baseUrl}}"], "path": ["leagues", "premier-league", "standings"]}
					}
				},
				{
					"name": "1.4 GET /leagues/{id}/top-scorers",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/leagues/premier-league/top-scorers", "host": ["{{baseUrl}}"], "path": ["leagues", "premier-league", "top-scorers"]}
					}
				}
			]
		},
		{
			"name": "2. Matches",
			"item": [
				{
					"name": "2.1 GET /matches/live",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/matches/live",
							"host": ["{{baseUrl}}"],
							"path": ["matches", "live"],
							"query": [
								{"key": "sport", "value": "football", "disabled": true}
							]
						}
					}
				},
				{
					"name": "2.2 GET /matches/schedule",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/matches/schedule?date=2026-03-31",
							"host": ["{{baseUrl}}"],
							"path": ["matches", "schedule"],
							"query": [
								{"key": "date", "value": "2026-03-31", "description": "Bắt buộc. YYYY-MM-DD"},
								{"key": "sport", "value": "football", "disabled": true},
								{"key": "league_id", "value": "premier-league", "disabled": true}
							]
						}
					}
				},
				{
					"name": "2.3 GET /matches/results",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/matches/results",
							"host": ["{{baseUrl}}"],
							"path": ["matches", "results"],
							"query": [
								{"key": "date", "value": "2026-03-31", "disabled": true},
								{"key": "sport", "value": "football", "disabled": true},
								{"key": "league_id", "value": "premier-league", "disabled": true},
								{"key": "page", "value": "1", "disabled": true},
								{"key": "limit", "value": "20", "disabled": true}
							]
						}
					}
				},
				{
					"name": "2.4 GET /matches/{id}",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/matches/match-12345", "host": ["{{baseUrl}}"], "path": ["matches", "match-12345"]}
					}
				},
				{
					"name": "2.5 GET /matches/{id}/events",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/matches/match-12345/events", "host": ["{{baseUrl}}"], "path": ["matches", "match-12345", "events"]}
					}
				},
				{
					"name": "2.6 GET /matches/{id}/lineups",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/matches/match-12345/lineups", "host": ["{{baseUrl}}"], "path": ["matches", "match-12345", "lineups"]}
					}
				},
				{
					"name": "2.7 GET /matches/{id}/h2h",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/matches/match-12345/h2h", "host": ["{{baseUrl}}"], "path": ["matches", "match-12345", "h2h"]}
					}
				}
			]
		},
		{
			"name": "3. Content",
			"item": [
				{
					"name": "3.1 GET /highlights",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/highlights",
							"host": ["{{baseUrl}}"],
							"path": ["highlights"],
							"query": [
								{"key": "sport", "value": "football", "disabled": true},
								{"key": "league_id", "value": "premier-league", "disabled": true},
								{"key": "match_id", "value": "match-12345", "disabled": true},
								{"key": "page", "value": "1", "disabled": true},
								{"key": "limit", "value": "20", "disabled": true}
							]
						}
					}
				},
				{
					"name": "3.2 GET /articles",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/articles",
							"host": ["{{baseUrl}}"],
							"path": ["articles"],
							"query": [
								{"key": "type", "value": "recap", "disabled": true, "description": "recap|preview|opinion|roundup"},
								{"key": "sport", "value": "football", "disabled": true},
								{"key": "page", "value": "1", "disabled": true},
								{"key": "limit", "value": "20", "disabled": true}
							]
						}
					}
				},
				{
					"name": "3.3 GET /articles/{id}",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/articles/1", "host": ["{{baseUrl}}"], "path": ["articles", "1"]}
					}
				},
				{
					"name": "3.4 GET /discover",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/discover",
							"host": ["{{baseUrl}}"],
							"path": ["discover"],
							"query": [
								{"key": "sport", "value": "football", "disabled": true},
								{"key": "page", "value": "1", "disabled": true},
								{"key": "limit", "value": "20", "disabled": true}
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Teams",
			"item": [
				{
					"name": "4.1 GET /teams/{id}",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/teams/arsenal", "host": ["{{baseUrl}}"], "path": ["teams", "arsenal"]}
					}
				},
				{
					"name": "4.2 GET /teams/{id}/matches",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/teams/arsenal/matches",
							"host": ["{{baseUrl}}"],
							"path": ["teams", "arsenal", "matches"],
							"query": [
								{"key": "status", "value": "all", "disabled": true, "description": "scheduled|finished|all"},
								{"key": "page", "value": "1", "disabled": true},
								{"key": "limit", "value": "20", "disabled": true}
							]
						}
					}
				}
			]
		},
		{
			"name": "5. Search",
			"item": [
				{
					"name": "5.1 GET /search",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/search?q=arsenal",
							"host": ["{{baseUrl}}"],
							"path": ["search"],
							"query": [
								{"key": "q", "value": "arsenal", "description": "Bắt buộc. Min 2 ký tự"},
								{"key": "type", "value": "all", "disabled": true, "description": "team|league|match|all"}
							]
						}
					}
				}
			]
		},
		{
			"name": "6. User (Firebase Auth)",
			"auth": {
				"type": "bearer",
				"bearer": [{"key": "token", "value": "{{firebaseToken}}", "type": "string"}]
			},
			"item": [
				{
					"name": "6.1 GET /user/profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/user/profile", "host": ["{{baseUrl}}"], "path": ["user", "profile"]}
					}
				},
				{
					"name": "6.2 PUT /user/favorites",
					"request": {
						"method": "PUT",
						"header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"favorite_teams\": [\"man-utd\", \"lakers\"],\n  \"favorite_sports\": [\"football\", \"basketball\"]\n}"
						},
						"url": {"raw": "{{baseUrl}}/user/favorites", "host": ["{{baseUrl}}"], "path": ["user", "favorites"]}
					}
				},
				{
					"name": "6.3 PUT /user/notification-settings",
					"request": {
						"method": "PUT",
						"header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"live_score\": true,\n  \"match_reminder\": true,\n  \"highlights\": true,\n  \"favorite_teams_only\": false\n}"
						},
						"url": {"raw": "{{baseUrl}}/user/notification-settings", "host": ["{{baseUrl}}"], "path": ["user", "notification-settings"]}
					}
				},
				{
					"name": "6.4 POST /user/reminders",
					"request": {
						"method": "POST",
						"header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"match_id\": \"match-12345\",\n  \"remind_before_minutes\": 15\n}"
						},
						"url": {"raw": "{{baseUrl}}/user/reminders", "host": ["{{baseUrl}}"], "path": ["user", "reminders"]}
					}
				},
				{
					"name": "6.5 GET /user/reminders",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/user/reminders", "host": ["{{baseUrl}}"], "path": ["user", "reminders"]}
					}
				},
				{
					"name": "6.6 DELETE /user/reminders/{matchId}",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/user/reminders/match-12345", "host": ["{{baseUrl}}"], "path": ["user", "reminders", "match-12345"]}
					}
				},
				{
					"name": "6.7 POST /user/fcm-token",
					"request": {
						"method": "POST",
						"header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"fcm-device-token-here\",\n  \"platform\": \"android\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/user/fcm-token", "host": ["{{baseUrl}}"], "path": ["user", "fcm-token"]}
					}
				},
				{
					"name": "6.8 DELETE /user/account",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {"raw": "{{baseUrl}}/user/account", "host": ["{{baseUrl}}"], "path": ["user", "account"]}
					}
				}
			]
		}
	]
}
