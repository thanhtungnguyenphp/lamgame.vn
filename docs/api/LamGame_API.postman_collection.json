					"name": "Update Extended Profile",
					"request": {
						"method": "PUT",
						"header": [{"key": "Accept", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bio\": \"Game developer\",\n  \"skills\": [\"Unity\", \"C#\"]\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {"raw": "{{baseUrl}}/auth/profile/extended", "host": ["{{baseUrl}}"], "path": ["auth", "profile", "extended"]}
