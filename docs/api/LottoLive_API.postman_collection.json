      "name": "1. Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/health", "host": ["{{base_url}}"], "path": ["lottery", "health"]},
            "header": [{"key": "Accept", "value": "application/json"}]
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Response OK', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('ok'); pm.expect(j).to.have.property('version'); pm.expect(j).to.have.property('sources'); });"]}}]
        }
      ]
    },
