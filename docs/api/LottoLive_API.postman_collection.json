{
  "info": {
    "name": "LottoLive API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lotto Live - API xổ số Việt Nam (truyền thống 3 miền + Vietlot + Dò số + Vé số)"
  },
  "variable": [
    {"key": "base_url", "value": "https://lamgame.vn/api/v1"}
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/health", "host": ["{{base_url}}"], "path": ["lottery", "health"]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        }
      ]
    },
    {
      "name": "2. XS Truyền Thống",
      "item": [
        {
          "name": "Miền Nam - Hôm nay",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/traditional?region=mien-nam", "host": ["{{base_url}}"], "path": ["lottery", "traditional"], "query": [{"key": "region", "value": "mien-nam"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Miền Trung - Hôm nay",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/traditional?region=mien-trung", "host": ["{{base_url}}"], "path": ["lottery", "traditional"], "query": [{"key": "region", "value": "mien-trung"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Miền Bắc - Hôm nay",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/traditional?region=mien-bac", "host": ["{{base_url}}"], "path": ["lottery", "traditional"], "query": [{"key": "region", "value": "mien-bac"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Ngày cụ thể + Tỉnh",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/traditional?region=mien-nam&date=2026-03-22&province=HCM", "host": ["{{base_url}}"], "path": ["lottery", "traditional"], "query": [{"key": "region", "value": "mien-nam"}, {"key": "date", "value": "2026-03-22"}, {"key": "province", "value": "HCM"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        }
      ]
    },
    {
      "name": "3. Vietlot",
      "item": [
        {
          "name": "Mega 6/45",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/vietlot?game=mega645", "host": ["{{base_url}}"], "path": ["lottery", "vietlot"], "query": [{"key": "game", "value": "mega645"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Power 6/55",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/vietlot?game=power655", "host": ["{{base_url}}"], "path": ["lottery", "vietlot"], "query": [{"key": "game", "value": "power655"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Max 3D",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/vietlot?game=max3d", "host": ["{{base_url}}"], "path": ["lottery", "vietlot"], "query": [{"key": "game", "value": "max3d"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Max 3D Pro",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/vietlot?game=max3d_pro", "host": ["{{base_url}}"], "path": ["lottery", "vietlot"], "query": [{"key": "game", "value": "max3d_pro"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Keno - Kỳ mới nhất",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/vietlot?game=keno&period=latest", "host": ["{{base_url}}"], "path": ["lottery", "vietlot"], "query": [{"key": "game", "value": "keno"}, {"key": "period", "value": "latest"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Keno - Theo ngày",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/vietlot?game=keno&date=2026-03-22", "host": ["{{base_url}}"], "path": ["lottery", "vietlot"], "query": [{"key": "game", "value": "keno"}, {"key": "date", "value": "2026-03-22"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        }
      ]
    },
    {
      "name": "4. Kết quả mới nhất",
      "item": [
        {
          "name": "Tất cả",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/latest", "host": ["{{base_url}}"], "path": ["lottery", "latest"]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Chỉ truyền thống",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/latest?include=traditional", "host": ["{{base_url}}"], "path": ["lottery", "latest"], "query": [{"key": "include", "value": "traditional"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Chỉ Vietlot",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/latest?include=vietlot", "host": ["{{base_url}}"], "path": ["lottery", "latest"], "query": [{"key": "include", "value": "vietlot"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        }
      ]
    },
    {
      "name": "5. Lịch quay số",
      "item": [
        {
          "name": "Lịch hôm nay",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/schedule", "host": ["{{base_url}}"], "path": ["lottery", "schedule"]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Lịch ngày cụ thể",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/lottery/schedule?date=2026-03-22&type=all", "host": ["{{base_url}}"], "path": ["lottery", "schedule"], "query": [{"key": "date", "value": "2026-03-22"}, {"key": "type", "value": "all"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        }
      ]
    },
    {
      "name": "6. Dò Số",
      "item": [
        {
          "name": "Dò số - Tất cả đài",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/lottery/check", "host": ["{{base_url}}"], "path": ["lottery", "check"]},
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": [\"123456\", \"56\"],\n  \"region\": \"mien-nam\",\n  \"date\": \"2026-03-22\"\n}"
            }
          }
        },
        {
          "name": "Dò số - Đài cụ thể",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/lottery/check", "host": ["{{base_url}}"], "path": ["lottery", "check"]},
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": [\"123456\"],\n  \"region\": \"mien-nam\",\n  \"date\": \"2026-03-22\",\n  \"province_code\": \"HCM\"\n}"
            }
          }
        },
        {
          "name": "Dò số - Miền Bắc",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/lottery/check", "host": ["{{base_url}}"], "path": ["lottery", "check"]},
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": [\"56\", \"789\"],\n  \"region\": \"mien-bac\",\n  \"date\": \"2026-03-22\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "7. Vé Số (User Tickets)",
      "item": [
        {
          "name": "Đăng ký vé",
          "request": {
            "method": "POST",
            "url": {"raw": "{{base_url}}/user/tickets", "host": ["{{base_url}}"], "path": ["user", "tickets"]},
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcm_token\": \"YOUR_FCM_TOKEN\",\n  \"numbers\": [\"123456\"],\n  \"region\": \"mien-nam\",\n  \"province_code\": \"HCM\",\n  \"draw_date\": \"2026-03-22\"\n}"
            }
          }
        },
        {
          "name": "Danh sách vé",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/user/tickets?fcm_token=YOUR_FCM_TOKEN", "host": ["{{base_url}}"], "path": ["user", "tickets"], "query": [{"key": "fcm_token", "value": "YOUR_FCM_TOKEN"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Danh sách vé - Filter trúng",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/user/tickets?fcm_token=YOUR_FCM_TOKEN&status=won", "host": ["{{base_url}}"], "path": ["user", "tickets"], "query": [{"key": "fcm_token", "value": "YOUR_FCM_TOKEN"}, {"key": "status", "value": "won"}]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Chi tiết vé",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/user/tickets/t_abc123def4", "host": ["{{base_url}}"], "path": ["user", "tickets", "t_abc123def4"]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        },
        {
          "name": "Xóa vé",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{base_url}}/user/tickets/t_abc123def4", "host": ["{{base_url}}"], "path": ["user", "tickets", "t_abc123def4"]},
            "header": [{"key": "Accept", "value": "application/json"}]
          }
        }
      ]
    }
  ]
}
