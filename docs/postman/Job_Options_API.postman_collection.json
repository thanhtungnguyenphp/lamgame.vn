        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs?per_page=10&search=&job_type=&location=&company=&salary_min=&salary_max=&is_urgent=&is_featured=&order_by=created_at&order_direction=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Items per page (max 50)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search in title/description"
                },
                {
                  "key": "job_type",
                  "value": "",
                  "description": "Filter by job type"
                },
                {
                  "key": "location",
                  "value": "",
                  "description": "Filter by location"
                },
                {
                  "key": "company",
                  "value": "",
                  "description": "Filter by company"
                },
                {
                  "key": "salary_min",
                  "value": "",
                  "description": "Minimum salary"
                },
                {
                  "key": "salary_max",
                  "value": "",
                  "description": "Maximum salary"
                },
                {
                  "key": "is_urgent",
                  "value": "",
                  "description": "Filter urgent jobs (boolean)"
                },
                {
                  "key": "is_featured",
                  "value": "",
                  "description": "Filter featured jobs (boolean)"
                },
                {
                  "key": "order_by",
                  "value": "created_at",
                  "description": "Order by field"
                },
                {
                  "key": "order_direction",
                  "value": "desc",
                  "description": "Order direction (asc/desc)"
                }
              ]
            },
            "description": "List job postings with filtering and pagination"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set timestamp for cache busting",
          "pm.globals.set('timestamp', Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global tests for all requests",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Response has success field', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});",
          "",
          "pm.test('Response has message field', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('message');",
          "});",
          "",
          "if (pm.response.code === 200) {",
          "    pm.test('Success response has data field', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('data');",
          "        pm.expect(jsonData.success).to.be.true;",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://lamgame.localhost",
      "description": "Base URL for the API (change to your local/staging/production URL)"
    },
    {
      "key": "api_version",
      "value": "1.0",
      "description": "API Version"
    }
  ]
}