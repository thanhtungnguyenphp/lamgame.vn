{
  "info": {
    "name": "Job Options API",
    "description": "Collection of API endpoints for job posting dropdown options and filters",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    }
  },
  "item": [
    {
      "name": "Job Options",
      "description": "API endpoints for job form options and filters",
      "item": [
        {
          "name": "1. Get All Filter Options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs/options/filter-options",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "options", "filter-options"]
            },
            "description": "Get all filter options for job search/filter forms. Returns job types, experience levels, salary ranges, categories, locations, skills, and benefits."
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/jobs/options/filter-options",
                  "host": ["{{base_url}}"],
                  "path": ["api", "jobs", "options", "filter-options"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Filter options retrieved successfully\",\n  \"data\": {\n    \"job_types\": [\n      {\n        \"id\": 1,\n        \"value\": \"Toàn thời gian\",\n        \"label\": \"Toàn thời gian\",\n        \"sort_order\": 1\n      }\n    ],\n    \"experience_levels\": [...],\n    \"salary_ranges\": [...],\n    \"categories\": [...],\n    \"locations\": [...],\n    \"popular_skills\": [...],\n    \"common_benefits\": [...]\n  }\n}"
            }
          ]
        },
        {
          "name": "2. Get Job Form Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs/options/form-data",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "options", "form-data"]
            },
            "description": "Combined endpoint for job creation forms. Returns all necessary data for initializing a job posting form."
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/jobs/options/form-data",
                  "host": ["{{base_url}}"],
                  "path": ["api", "jobs", "options", "form-data"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Job form data retrieved successfully\",\n  \"data\": {\n    \"attributes\": {\n      \"job_type\": {\n        \"code\": \"job_type\",\n        \"name\": \"Loại hình công việc\",\n        \"type\": \"select\",\n        \"is_required\": true,\n        \"options\": [...]\n      }\n    },\n    \"categories\": [...],\n    \"locations\": [...],\n    \"popular_skills\": [...],\n    \"common_benefits\": [...],\n    \"application_methods\": [...]\n  }\n}"
            }
          ]
        },
        {
